# Copy these into Streamlit Cloud: your app > Settings > Secrets.
# For local testing, save as .streamlit/secrets.toml (never commit it).

# Supabase > Connect > "Session pooler" connection string, with your database password filled in.
DATABASE_URL = "postgresql://postgres.YOURPROJECT:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Unlocks the Commissioner page. Pick something only you know.
ADMIN_PASSWORD = "change-me"

# Optional here (lets you pull from ESPN inside the app). Also add all three as GitHub secrets for the weekly job.
ESPN_LEAGUE_ID = "68125763"
ESPN_S2 = "paste espn_s2 cookie"
ESPN_SWID = "{paste-SWID-cookie}"
